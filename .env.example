# Purpose: RestoreProof environment template
# Author: Doug Hesseltine
# Created: 2026-07-12
# Modified: 2026-09-17
# Version: 1.3.0
#
# Copy to .env and adjust values before local compose deploy.
# Portainer: set the same concepts via the Environment variables panel
#   POSTGRES_PASSWORD  → openssl rand -hex 24
#   API_SECRET_KEY     → openssl rand -hex 32  (maps to SECRET_KEY)
#   WORKER_SECRET_KEY  → identical to API_SECRET_KEY
#
# Use hex-only secrets. Do NOT use base64 or characters: # @ : / ? % &
# Those break YAML comments and DATABASE_URL parsing.

POSTGRES_USER=restoreproof
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=restoreproof

# JWT + Fernet encryption of Proxmox/SMTP secrets (32+ chars; prefer openssl rand -hex 32)
# Portainer name: API_SECRET_KEY / WORKER_SECRET_KEY (must match each other)
SECRET_KEY=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=

# Optional public URL for password-reset / notification email links (NPM domain, etc.)
# Portainer: set APP_BASE_URL on api and worker. Also configurable in Notifications.
APP_BASE_URL=http://localhost:3080

# CORS — "*" is fine; the web container same-origin proxies /api
CORS_ORIGINS=*

API_PORT=8000
WEB_PORT=3080

# Leave empty when using the nginx proxy in the web container (/api → api:8000)
VITE_API_URL=

# Evidence / screenshot storage inside containers
DATA_DIR=/data

# Default boot wait before screenshot (seconds)
DEFAULT_BOOT_WAIT_SECONDS=60
