# RestoreProof environment template
# Author: Doug Hesseltine
# Created: 2026-07-12
# Modified: 2026-07-12
# Version: 1.1.0
#
# Copy to .env and adjust values before deploy.
# Portainer: set the same keys as stack environment variables (see PORTAINER.md).

POSTGRES_USER=restoreproof
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=restoreproof

# Used for JWT signing and Fernet encryption of stored secrets (32+ random bytes, url-safe)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=

# Public URL of the web UI (used in password-reset emails)
APP_BASE_URL=http://localhost:3080

# Cookie / CORS — include the exact origin you use in the browser
CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080

API_PORT=8000
WEB_PORT=3080

# Image tag for portainer-stack.yml (latest or a pinned version e.g. 1.1.0)
RESTOREPROOF_TAG=latest

# Leave empty when using the nginx proxy in the web container (/api → api:8000)
VITE_API_URL=

# Evidence / screenshot storage inside containers
DATA_DIR=/data

# Default boot wait before screenshot (seconds)
DEFAULT_BOOT_WAIT_SECONDS=60
